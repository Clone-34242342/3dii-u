diff --git a/src/gallium/drivers/r600/sb/sb_ir.h b/src/gallium/drivers/r600/sb/sb_ir.h
index eecf17d..840c9a0 100644
--- a/src/gallium/drivers/r600/sb/sb_ir.h
+++ b/src/gallium/drivers/r600/sb/sb_ir.h
@@ -770,7 +770,7 @@ protected:
 	node(node_type nt, node_subtype nst, node_flags flags = NF_EMPTY)
 	: prev(), next(), parent(),
 	  type(nt), subtype(nst), flags(flags),
-	  pred(), dst(), src() {}
+	  pred(), dst(), src(), uid() {}
 
 	virtual ~node() {};
 
@@ -787,6 +787,11 @@ public:
 	vvec dst;
 	vvec src;
 
+	/* creation order within the shader (shader::create_*): containers keyed
+	 * by node pointer compare by it, so the compiler's output doesn't depend
+	 * on where the allocator put the nodes */
+	unsigned uid;
+
 	virtual bool is_valid() { return true; }
 	virtual bool accept(vpass &p, bool enter);
 
@@ -1180,7 +1185,13 @@ typedef std::list<node*> sched_queue;
 typedef sched_queue::iterator sq_iterator;
 typedef std::vector<node*> node_vec;
 typedef std::list<node*> node_list;
-typedef std::set<node*> node_set;
+struct node_uid_less {
+	bool operator()(const node *a, const node *b) const {
+		return a->uid != b->uid ? a->uid < b->uid : a < b; /* nodes made outside shader::create_* keep uid 0 */
+	}
+};
+
+typedef std::set<node*, node_uid_less> node_set;
 
 
 
